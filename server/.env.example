DATABASE_URL="postgresql://USER@localhost:5432/loan_manager?schema=public"
# Required by Prisma (schema.prisma `directUrl`). Locally, use the same value
# as DATABASE_URL. In production with a pooled (pgbouncer) DATABASE_URL, e.g.
# Neon's default pooled connection, set this to the unpooled connection string.
DIRECT_URL="postgresql://USER@localhost:5432/loan_manager?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-string"
# Business timezone for "today", due dates and the no-future-payments rule.
# APP_TIMEZONE="Asia/Kolkata"
# Vercel Blob read-write token. When set, customer photos, loan documents and
# the company logo are stored in Blob (required on Vercel); customer KYC
# documents always need it. Leave unset locally to store files in
# server/uploads. Get one from your Blob store or `vercel env pull`.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Integration tests use <DATABASE_URL db>_test unless this is set. The name
# must end in _test — tests truncate every table.
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/loan_manager_test?schema=public"
