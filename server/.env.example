DATABASE_URL="postgresql://USER@localhost:5432/loan_manager?schema=public"
# Optional: unpooled connection string, used only by `prisma migrate deploy`.
# Required in production if DATABASE_URL is a pooled (pgbouncer) connection
# string, e.g. Neon's default pooled connection. Falls back to DATABASE_URL
# when unset.
DIRECT_URL="postgresql://USER@localhost:5432/loan_manager?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-string"
# Vercel Blob read-write token (customer document uploads). Get one by
# creating a Blob store on Vercel and running `vercel env pull`, or from the
# store's dashboard. Not needed unless you're testing document uploads
# locally.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
