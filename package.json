{
  "name": "loan-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Loan tracking application for loans and repayments (daily/weekly/monthly, flat & reducing-balance interest).",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace shared",
    "db:migrate": "npm run migrate --workspace server",
    "db:seed": "npm run seed --workspace server",
    "db:reset": "npm run reset --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
